[gd_scene format=3]

[ext_resource type="Script" path="res://function/script/UnitInfoUI.gd" id="1"]
[ext_resource type="StyleBox" path="res://content/resource/stylebox/8bit_style_box_flat.tres" id="1_ks8yl"]
[ext_resource type="PackedScene" path="res://content/scenes/ui/components/UnitInfoPanel.tscn" id="2_info"]

[node name="UnitInfoUI" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_styles/panel = ExtResource("1_ks8yl")
script = ExtResource("1")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "单位图鉴"
horizontal_alignment = 1

[node name="HBoxContainer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3

[node name="ScrollContainer" type="ScrollContainer" parent="VBoxContainer/HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="UnitList" type="VBoxContainer" parent="VBoxContainer/HBoxContainer/ScrollContainer"]
layout_mode = 2

[node name="InfoPanel" parent="VBoxContainer/HBoxContainer" instance=ExtResource("2_info")]
layout_mode = 2
size_flags_horizontal = 2
size_flags_vertical = 3

[node name="BackButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 0
theme_override_font_sizes/font_size = 8
text = "返回"

[connection signal="pressed" from="VBoxContainer/BackButton" to="." method="_on_back_button_pressed"]