			  "speaker": "守火者",
			  "text": "你走了五趟了。"
			},
			{
			  "speaker": "守火者",
			  "text": "……我数着的。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"min_run_count": 10.0
		  },
		  "id": "keeper_chat_5",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "我叫不出你的名字。"
			},
			{
			  "speaker": "守火者",
			  "text": "但我记得你每一次回来。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"min_run_count": 20.0
		  },
		  "id": "keeper_chat_6",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "燃薪者……"
			},
			{
			  "speaker": "守火者",
			  "text": "不，你不是燃薪者了。"
			},
			{
			  "speaker": "守火者",
			  "text": "你已经是火本身。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "choices": [
			{
			  "flag": "keeper_asked_why",
			  "text": "你为什么守着火？"
			},
			{
			  "flag": "keeper_silent",
			  "text": "……没什么。"
			}
		  ],
		  "condition": {
			"min_altar_level": 2.0
		  },
		  "id": "keeper_curious",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "……"
			},
			{
			  "speaker": "守火者",
			  "text": "你在看我？"
			}
		  ],
		  "priority": 5.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"flags": [
              "keeper_silent"
			]
		  },
		  "id": "keeper_silent_branch",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "……算了。你不想听，我不说。"
			}
		  ],
		  "priority": 3.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"flags": [
              "keeper_asked_why"
			],
			"min_altar_level": 3.0
		  },
		  "id": "keeper_truth",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "火里有人在等我。"
			},
			{
			  "speaker": "守火者",
			  "text": "一个被封印的灵魂。"
			},
			{
			  "speaker": "守火者",
			  "text": "……我终究还是告诉你了。"
			}
		  ],
		  "priority": 10.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"flags": [
              "keeper_asked_why"
			],
			"min_run_count": 8.0
		  },
		  "id": "keeper_truth_2",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "她被封印了多久……我不记得了。"
			},
			{
			  "speaker": "守火者",
			  "text": "我只记得她最后说的话。"
			},
			{
			  "speaker": "守火者",
			  "text": "她说：火不会灭的。"
			}
		  ],
		  "priority": 10.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"flags": [
