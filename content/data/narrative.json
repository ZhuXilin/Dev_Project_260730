		  },
		  "id": "glad_truth",
		  "lines": [
			{
			  "speaker": "角斗士",
			  "text": "终燃之战……我是将军。"
			},
			{
			  "speaker": "角斗士",
			  "text": "我输了。所有人都输了。"
			}
		  ],
		  "priority": 10.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"flags": [
              "glad_asked_past"
			],
			"min_arena_clear": 4.0
		  },
		  "id": "glad_truth_2",
		  "lines": [
			{
			  "speaker": "角斗士",
			  "text": "我下令撤退。有一半人没听到。"
			},
			{
			  "speaker": "角斗士",
			  "text": "……有时候我还能听到他们在喊我的名字。"
			}
		  ],
		  "priority": 10.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"flags": [
              "glad_asked_past"
			],
			"min_arena_clear": 5.0
		  },
		  "id": "glad_truth_3",
		  "lines": [
			{
			  "speaker": "角斗士",
			  "text": "你让我想起一件事。"
			},
			{
			  "speaker": "角斗士",
			  "text": "每次我打倒一个对手，我都记下他的名字。"
			},
			{
			  "speaker": "角斗士",
			  "text": "……都记在这儿了。"
			}
		  ],
		  "priority": 10.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"flags": [
              "glad_asked_past"
			],
			"min_arena_clear": 5.0
		  },
		  "id": "glad_final",
		  "lines": [
			{
			  "speaker": "角斗士",
			  "text": "你让我想起了当年的自己。"
			},
			{
			  "speaker": "角斗士",
			  "text": "去告诉火——有人还站着。"
			}
