  "npcs": {
	"soul_keeper": {
	  "name": "守火者",
	  "default_trigger_type": "npc_interact",
	  "dialogues": [
		{
		  "id": "keeper_00",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "守火者", "text": "火……又旺了一点。"},
			{"speaker": "守火者", "text": "你带回来的魂，我收到了。"}
		  ]
		},
		{
		  "id": "keeper_01",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_altar_level": 1},
		  "lines": [
			{"speaker": "守火者", "text": "别急。火要慢慢烧，才烧得久。"}
		  ]
		},
		{
		  "id": "keeper_02",
		  "priority": 1,
		  "repeatable": false,
		  "condition": {"min_altar_level": 2},
		  "lines": [
			{"speaker": "守火者", "text": "又一个灵魂……被火记住了。"}
		  ]
		},
		{
		  "id": "keeper_chat_1",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "守火者", "text": "火需要柴。人也需要。"},
			{"speaker": "守火者", "text": "……你多久没吃东西了？"}
		  ]
		},
		{
		  "id": "keeper_chat_2",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "守火者", "text": "灰烬里有时能捡到旧世界的东西。"},
			{"speaker": "守火者", "text": "上次我捡到一枚戒指。没有主人了。"}
		  ]
		},
		{
		  "id": "keeper_chat_3",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "守火者", "text": "你走的时候，火会小一点。"},
			{"speaker": "守火者", "text": "你回来的时候，火会大一点。"}
		  ]
		},
		{
		  "id": "keeper_chat_4",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_run_count": 5},
		  "lines": [
			{"speaker": "守火者", "text": "你走了五趟了。"},
			{"speaker": "守火者", "text": "……我数着的。"}
		  ]
		},
		{
		  "id": "keeper_chat_5",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_run_count": 10},
		  "lines": [
			{"speaker": "守火者", "text": "我叫不出你的名字。"},
			{"speaker": "守火者", "text": "但我记得你每一次回来。"}
		  ]
		},
		{
		  "id": "keeper_chat_6",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_run_count": 20},
		  "lines": [
			{"speaker": "守火者", "text": "燃薪者……"},
			{"speaker": "守火者", "text": "不，你不是燃薪者了。"},
			{"speaker": "守火者", "text": "你已经是火本身。"}
		  ]
		},
		{
		  "id": "keeper_curious",
		  "priority": 5,
		  "repeatable": false,
		  "condition": {"min_altar_level": 2},
		  "lines": [
			{"speaker": "守火者", "text": "……"},
			{"speaker": "守火者", "text": "你在看我？"}
		  ],
		  "choices": [
			{"text": "你为什么守着火？", "flag": "keeper_asked_why"},
			{"text": "……没什么。", "flag": "keeper_silent"}
		  ]
		},
		{
		  "id": "keeper_silent_branch",
		  "priority": 3,
		  "repeatable": false,
		  "condition": {"flags": ["keeper_silent"]},
		  "lines": [
			{"speaker": "守火者", "text": "……算了。你不想听，我不说。"}
		  ]
		},
		{
		  "id": "keeper_truth",
		  "priority": 10,
		  "repeatable": false,
		  "condition": {"min_altar_level": 3, "flags": ["keeper_asked_why"]},
		  "lines": [
			{"speaker": "守火者", "text": "火里有人在等我。"},
			{"speaker": "守火者", "text": "一个被封印的灵魂。"},
			{"speaker": "守火者", "text": "……我终究还是告诉你了。"}
		  ]
		},
		{
		  "id": "keeper_truth_2",
		  "priority": 10,
		  "repeatable": false,
		  "condition": {"min_run_count": 8, "flags": ["keeper_asked_why"]},
		  "lines": [
			{"speaker": "守火者", "text": "她被封印了多久……我不记得了。"},
			{"speaker": "守火者", "text": "我只记得她最后说的话。"},
			{"speaker": "守火者", "text": "她说：火不会灭的。"}
		  ]
		},
		{
		  "id": "keeper_truth_3",
		  "priority": 10,
		  "repeatable": false,
		  "condition": {"min_altar_level": 5, "flags": ["keeper_asked_why"]},
		  "lines": [
			{"speaker": "守火者", "text": "你在变强。"},
			{"speaker": "守火者", "text": "强到也许能解开封印。"}
		  ]
		},
		{
		  "id": "keeper_final",
		  "priority": 15,
		  "repeatable": false,
		  "condition": {"min_altar_level": 4, "flags": ["keeper_asked_why"]},
		  "lines": [
			{"speaker": "守火者", "text": "你的影子……开始像火了。"},
			{"speaker": "守火者", "text": "去唤醒它吧。"}
		  ]
		},
		{
		  "id": "keeper_default",
		  "priority": -1,
		  "repeatable": true,
		  "condition": {},
		  "lines": [
			{"speaker": "守火者", "text": "火还烧着。"}
		  ]
		}
	  ],
	  "unlocks": []
	},

	"blacksmith": {
	  "name": "灰烬铁匠",
	  "default_trigger_type": "npc_interact",
	  "dialogues": [
		{
		  "id": "smith_00",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "又来了？这次带什么材料……"},
			{"speaker": "灰烬铁匠", "text": "哦，你什么都没有。行吧，拿魂来。"}
		  ]
		},
		{
		  "id": "smith_01",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_weapon_max_level": 1},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "这把武器还没死透，再烧烧。"}
		  ]
		},
		{
		  "id": "smith_02",
		  "priority": 1,
		  "repeatable": false,
		  "condition": {"min_weapon_max_level": 2},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "旧世界的东西……比现在结实多了。"}
		  ]
		},
		{
		  "id": "smith_chat_1",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "你看看我这只手。"},
			{"speaker": "灰烬铁匠", "text": "灰烬做的。能打铁，但不能握刀了。"}
		  ]
		},
		{
		  "id": "smith_chat_2",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "打铁要听声音。"},
			{"speaker": "灰烬铁匠", "text": "声音不对，火候就错了。"}
		  ]
		},
		{
		  "id": "smith_chat_3",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_run_count": 5},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "五趟了？你这小子挺能扛。"},
			{"speaker": "灰烬铁匠", "text": "……别死在外面。我还缺个学徒。"}
		  ]
		},
		{
		  "id": "smith_chat_4",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_run_count": 10},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "我年轻的时候，一拳能砸碎铁砧。"},
			{"speaker": "灰烬铁匠", "text": "现在……嘿，还能砸碎你的脑袋。"}
		  ]
		},
		{
		  "id": "smith_chat_5",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_weapon_max_level": 3},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "你这把武器……有意思。"},
			{"speaker": "灰烬铁匠", "text": "里面有个声音，在烧。"}
		  ]
		},
		{
		  "id": "smith_curious",
		  "priority": 5,
		  "repeatable": false,
		  "condition": {"min_weapon_max_level": 2},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "你怎么老盯着我的铁砧？"}
		  ],
		  "choices": [
			{"text": "旧世界是什么样的？", "flag": "smith_asked_old_world"},
			{"text": "没什么。", "flag": "smith_silent"}
		  ]
		},
		{
		  "id": "smith_truth",
		  "priority": 10,
		  "repeatable": false,
		  "condition": {"min_weapon_max_level": 3, "flags": ["smith_asked_old_world"]},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "终燃之前，我是最著名的锻造师。"},
			{"speaker": "灰烬铁匠", "text": "现在只剩这破铁砧了。"}
		  ]
		},
		{
		  "id": "smith_truth_2",
		  "priority": 10,
		  "repeatable": false,
		  "condition": {"min_run_count": 8, "flags": ["smith_asked_old_world"]},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "我锻过一把剑，给一位将军。"},
			{"speaker": "灰烬铁匠", "text": "那把剑现在在哪……谁知道呢。"},
			{"speaker": "灰烬铁匠", "text": "也许就在你身后。"}
		  ]
		},
		{
		  "id": "smith_final",
		  "priority": 15,
		  "repeatable": false,
		  "condition": {"min_weapon_max_level": 4, "flags": ["smith_asked_old_world"]},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "拿着——这是最后一炉。"},
			{"speaker": "灰烬铁匠", "text": "别弄丢。"}
		  ]
		},
		{
		  "id": "smith_default",
		  "priority": -1,
		  "repeatable": true,
		  "condition": {},
		  "lines": [
			{"speaker": "灰烬铁匠", "text": "拿魂来，我什么都能打。"}
		  ]
		}
	  ],
	  "unlocks": [
		{
		  "type": "relic",
		  "id": "relic_phoenix",
		  "conditions": {
			"min_weapon_max_level": 4,
			"min_dialogue_count": 5,
			"flags": ["smith_asked_old_world"]
		  }
		}
	  ]
	},

	"guide": {
	  "name": "游魂向导",
	  "default_trigger_type": "npc_interact",
	  "dialogues": [
		{
		  "id": "guide_00",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "游魂向导", "text": "北边的灰烬矿脉？我去过。"},
			{"speaker": "游魂向导", "text": "那里风很大，魂很轻。"}
		  ]
		},
		{
		  "id": "guide_01",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_dispatch_count": 1},
		  "lines": [
			{"speaker": "游魂向导", "text": "你派谁去？那个刺客？"},
			{"speaker": "游魂向导", "text": "他脚程快，但话少。我喜欢话少的。"}
		  ]
		},
		{
		  "id": "guide_02",
		  "priority": 1,
		  "repeatable": false,
		  "condition": {"min_dispatch_count": 5},
		  "lines": [
			{"speaker": "游魂向导", "text": "今天路不好走，有些道被封了。你挑别的吧。"}
		  ]
		},
		{
		  "id": "guide_chat_1",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "游魂向导", "text": "你见过会走路的树吗？"},
			{"speaker": "游魂向导", "text": "我见过。在终燃之后的第一个冬天。"}
		  ]
		},
		{
		  "id": "guide_chat_2",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "游魂向导", "text": "地图是活的。今天走的道，明天可能就没了。"},
			{"speaker": "游魂向导", "text": "所以我不画地图。我记风。"}
		  ]
		},
		{
		  "id": "guide_chat_3",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_dispatch_count": 3},
		  "lines": [
			{"speaker": "游魂向导", "text": "你知道吗？派遣出去的人……"},
			{"speaker": "游魂向导", "text": "有时候会带回奇怪的东西。上回一个士兵带回了一块糖。"}
		  ]
		},
		{
		  "id": "guide_chat_4",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_dispatch_count": 6},
		  "lines": [
			{"speaker": "游魂向导", "text": "你问我不累吗？"},
			{"speaker": "游魂向导", "text": "我是游魂。累是活人才有的感觉。"}
		  ]
		},
		{
		  "id": "guide_chat_5",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_run_count": 15},
		  "lines": [
			{"speaker": "游魂向导", "text": "你走了十五趟。"},
			{"speaker": "游魂向导", "text": "我见过很多人走到第十趟就……不走了。"}
		  ]
		},
		{
		  "id": "guide_curious",
		  "priority": 5,
		  "repeatable": false,
		  "condition": {"min_dispatch_count": 5},
		  "lines": [
			{"speaker": "游魂向导", "text": "你走神了。在想什么？"}
		  ],
		  "choices": [
			{"text": "你以前是做什么的？", "flag": "guide_asked_past"},
			{"text": "没什么。", "flag": "guide_silent"}
		  ]
		},
		{
		  "id": "guide_truth",
		  "priority": 10,
		  "repeatable": false,
		  "condition": {"min_dispatch_count": 8, "flags": ["guide_asked_past"]},
		  "lines": [
			{"speaker": "游魂向导", "text": "终燃之前，我是探险家。"},
			{"speaker": "游魂向导", "text": "现在……只剩风还记得我的名字。"}
		  ]
		},
		{
		  "id": "guide_truth_2",
		  "priority": 10,
		  "repeatable": false,
		  "condition": {"min_dispatch_count": 12, "flags": ["guide_asked_past"]},
		  "lines": [
			{"speaker": "游魂向导", "text": "我去过一个地方，那里还有一朵花。"},
			{"speaker": "游魂向导", "text": "真的花。不是我这种风。"},
			{"speaker": "游魂向导", "text": "……我一直想再去看一眼。"}
		  ]
		},
		{
		  "id": "guide_final",
		  "priority": 15,
		  "repeatable": false,
		  "condition": {"min_dispatch_count": 10, "flags": ["guide_asked_past"]},
		  "lines": [
			{"speaker": "游魂向导", "text": "有一条路，我一直没告诉你。"},
			{"speaker": "游魂向导", "text": "终燃之眼——去了可能回不来。"}
		  ]
		},
		{
		  "id": "guide_default",
		  "priority": -1,
		  "repeatable": true,
		  "condition": {},
		  "lines": [
			{"speaker": "游魂向导", "text": "风停了。要出发了吗？"}
		  ]
		}
	  ],
	  "unlocks": [
		{"type": "route", "id": "mine",   "conditions": {"after_dialogue": "guide_00"}},
		{"type": "route", "id": "forest", "conditions": {"after_dialogue": "guide_chat_2"}},
		{"type": "route", "id": "shrine", "conditions": {"after_dialogue": "guide_curious"}},
		{"type": "route", "id": "volcano","conditions": {"after_dialogue": "guide_truth_2"}},
		{"type": "route", "id": "abyss",  "conditions": {"after_dialogue": "guide_final"}},
		{
		  "type": "relic",
		  "id": "relic_speed",
		  "conditions": {
			"min_dispatch_count": 10,
			"min_dialogue_count": 5,
			"flags": ["guide_asked_past"]
		  }
		}
	  ]
	},

	"gladiator": {
	  "name": "角斗士",
	  "default_trigger_type": "npc_interact",
	  "dialogues": [
		{
		  "id": "glad_00",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [{"speaker": "角斗士", "text": "你回来了。手还稳吗？"}]
		},
		{
		  "id": "glad_01",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_arena_clear": 1},
		  "lines": [
			{"speaker": "角斗士", "text": "上次那个Boss，你打得不错。"},
			{"speaker": "角斗士", "text": "但下次会更难。"}
		  ]
		},
		{
		  "id": "glad_02",
		  "priority": 1,
		  "repeatable": false,
		  "condition": {"min_arena_clear": 2},
		  "lines": [
			{"speaker": "角斗士", "text": "规则变了。这次不能用魂火。"},
			{"speaker": "角斗士", "text": "你怕吗？"}
		  ]
		},
		{
		  "id": "glad_chat_1",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "角斗士", "text": "斗技场不是为了荣耀。"},
			{"speaker": "角斗士", "text": "是为了知道自己还能站着。"}
		  ]
		},
		{
		  "id": "glad_chat_2",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {},
		  "lines": [
			{"speaker": "角斗士", "text": "绷带下面？"},
			{"speaker": "角斗士", "text": "……你不想看的。"}
		  ]
		},
		{
		  "id": "glad_chat_3",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_arena_clear": 1},
		  "lines": [
			{"speaker": "角斗士", "text": "赢了就笑，输了就骂。"},
			{"speaker": "角斗士", "text": "别憋着。憋着的人打不出好拳。"}
		  ]
		},
		{
		  "id": "glad_chat_4",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_arena_clear": 3},
		  "lines": [
			{"speaker": "角斗士", "text": "你打得不像是为了赢。"},
			{"speaker": "角斗士", "text": "……也不像是我。"}
		  ]
		},
		{
		  "id": "glad_chat_5",
		  "priority": 0,
		  "repeatable": false,
		  "condition": {"min_run_count": 15},
		  "lines": [
			{"speaker": "角斗士", "text": "十五趟了。"},
			{"speaker": "角斗士", "text": "你不是在打仗。你是在走一条路。"}
		  ]
		},
		{
		  "id": "glad_curious",
		  "priority": 5,
		  "repeatable": false,
		  "condition": {"min_arena_clear": 2},
		  "lines": [
			{"speaker": "角斗士", "text": "你打得不像是为了赢。"},
			{"speaker": "角斗士", "text": "你在找什么？"}
		  ],
