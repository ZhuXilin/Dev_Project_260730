	"soul_keeper": {
	  "avatar": "npc_soul_keeper",
	  "default_trigger_type": "npc_interact",
	  "dialogues": [
		{
		  "condition": {},
		  "id": "keeper_00",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "火……又旺了一点。"
			},
			{
			  "speaker": "守火者",
			  "text": "你带回来的魂，我收到了。"
			}
