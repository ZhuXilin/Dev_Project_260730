	"guide": {
	  "avatar": "npc_guide",
	  "default_trigger_type": "npc_interact",
	  "dialogues": [
		{
		  "condition": {},
		  "id": "guide_00",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "北边的灰烬矿脉？我去过。"
			},
			{
			  "speaker": "游魂向导",
			  "text": "那里风很大，魂很轻。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"min_dispatch_count": 1.0
		  },
		  "id": "guide_01",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "你派谁去？那个刺客？"
			},
			{
			  "speaker": "游魂向导",
			  "text": "他脚程快，但话少。我喜欢话少的。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"min_dispatch_count": 5.0
		  },
		  "id": "guide_02",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "今天路不好走，有些道被封了。你挑别的吧。"
			}
		  ],
		  "priority": 1.0,
		  "repeatable": false
		},
		{
		  "condition": {},
		  "id": "guide_chat_1",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "你见过会走路的树吗？"
			},
			{
			  "speaker": "游魂向导",
			  "text": "我见过。在终燃之后的第一个冬天。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {},
		  "id": "guide_chat_2",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "地图是活的。今天走的道，明天可能就没了。"
			},
			{
			  "speaker": "游魂向导",
			  "text": "所以我不画地图。我记风。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"min_dispatch_count": 3.0
		  },
		  "id": "guide_chat_3",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "你知道吗？派遣出去的人……"
			},
			{
			  "speaker": "游魂向导",
			  "text": "有时候会带回奇怪的东西。上回一个士兵带回了一块糖。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"min_dispatch_count": 6.0
		  },
		  "id": "guide_chat_4",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "你问我不累吗？"
			},
			{
			  "speaker": "游魂向导",
			  "text": "我是游魂。累是活人才有的感觉。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"min_run_count": 15.0
		  },
		  "id": "guide_chat_5",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "你走了十五趟。"
			},
			{
			  "speaker": "游魂向导",
			  "text": "我见过很多人走到第十趟就……不走了。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "choices": [
			{
			  "flag": "guide_asked_past",
			  "text": "你以前是做什么的？"
			},
			{
			  "flag": "guide_silent",
			  "text": "没什么。"
			}
		  ],
		  "condition": {
			"min_dispatch_count": 5.0
		  },
		  "id": "guide_curious",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "你走神了。在想什么？"
			}
		  ],
		  "priority": 5.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"flags": [
              "guide_asked_past"
			],
			"min_dispatch_count": 8.0
		  },
		  "id": "guide_truth",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "终燃之前，我是探险家。"
			},
			{
			  "speaker": "游魂向导",
			  "text": "现在……只剩风还记得我的名字。"
			}
		  ],
		  "priority": 10.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"flags": [
              "guide_asked_past"
			],
			"min_dispatch_count": 12.0
		  },
		  "id": "guide_truth_2",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "我去过一个地方，那里还有一朵花。"
			},
			{
			  "speaker": "游魂向导",
			  "text": "真的花。不是我这种风。"
			},
			{
			  "speaker": "游魂向导",
			  "text": "……我一直想再去看一眼。"
			}
		  ],
		  "priority": 10.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"flags": [
              "guide_asked_past"
			],
			"min_dispatch_count": 10.0
		  },
		  "id": "guide_final",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "有一条路，我一直没告诉你。"
			},
			{
			  "speaker": "游魂向导",
			  "text": "终燃之眼——去了可能回不来。"
			}
		  ],
		  "priority": 15.0,
		  "repeatable": false
		},
		{
		  "condition": {},
		  "id": "guide_default",
		  "lines": [
			{
			  "speaker": "游魂向导",
			  "text": "风停了。要出发了吗？"
			}
		  ],
		  "priority": -1.0,
		  "repeatable": true
		}
	  ],
