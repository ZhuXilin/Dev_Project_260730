			{
			  "speaker": "守火者",
			  "text": "强到也许能解开封印。"
			}
		  ],
		  "priority": 10.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"flags": [
              "keeper_asked_why"
			],
			"min_altar_level": 4.0
		  },
		  "id": "keeper_final",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "你的影子……开始像火了。"
			},
			{
			  "speaker": "守火者",
			  "text": "去唤醒它吧。"
			}
		  ],
		  "priority": 15.0,
		  "repeatable": false
		},
		{
		  "condition": {},
		  "id": "keeper_default",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "火还烧着。"
			}
		  ],
		  "priority": -1.0,
		  "repeatable": true
		}
