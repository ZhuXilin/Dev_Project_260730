		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"min_altar_level": 1.0
		  },
		  "id": "keeper_01",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "别急。火要慢慢烧，才烧得久。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"min_altar_level": 2.0
		  },
		  "id": "keeper_02",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "又一个灵魂……被火记住了。"
			}
		  ],
		  "priority": 1.0,
		  "repeatable": false
		},
		{
		  "condition": {},
		  "id": "keeper_chat_1",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "火需要柴。人也需要。"
			},
			{
			  "speaker": "守火者",
			  "text": "……你多久没吃东西了？"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {},
		  "id": "keeper_chat_2",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "灰烬里有时能捡到旧世界的东西。"
			},
			{
			  "speaker": "守火者",
			  "text": "上次我捡到一枚戒指。没有主人了。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {},
		  "id": "keeper_chat_3",
		  "lines": [
			{
			  "speaker": "守火者",
			  "text": "你走的时候，火会小一点。"
			},
			{
			  "speaker": "守火者",
			  "text": "你回来的时候，火会大一点。"
			}
		  ],
		  "priority": 0.0,
		  "repeatable": false
		},
		{
		  "condition": {
			"min_run_count": 5.0
		  },
		  "id": "keeper_chat_4",
		  "lines": [
